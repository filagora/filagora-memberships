includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    # The package's own config/ is not the host app's config path; ArchTest guards src/ instead.
    noEnvCallsOutsideOfConfig: false
    paths:
        - src
        - config
    ignoreErrors:
        # Traits meant for the host application's own classes.
        -
            identifier: trait.unused
